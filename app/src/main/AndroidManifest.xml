<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="app.spektralab"
    android:versionCode="835"
    android:versionName="1.7.4p">
    <uses-sdk android:minSdkVersion="24" android:targetSdkVersion="36" tools:ignore="GradleOverrides"/>
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32"/>
    <!-- The desk reads this app's own album folder. Without this, scoped storage
         hands back only the files the current install wrote. -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES"/>
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- One 8 ms tick per detent; without this the view haptics are a no-op
         on ROMs that keep "touch vibration" off. -->
    <uses-permission android:name="android.permission.VIBRATE"/>
    <!-- **What the pickers are.** targetSdk is 36, so package visibility is in
         force: without these declarations `resolveActivity("…GET_CONTENT")`
         answers null even when the system picker exists, and every storage
         entry in the app reports "本机没有…". The launch path no longer depends
         on it, but declaring them also keeps the queries honest for anything
         that does. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.OPEN_DOCUMENT"/>
            <category android:name="android.intent.category.OPENABLE"/>
            <data android:mimeType="*/*"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.GET_CONTENT"/>
            <category android:name="android.intent.category.OPENABLE"/>
            <data android:mimeType="*/*"/>
        </intent>
        <intent>
            <action android:name="android.provider.action.PICK_IMAGES"/>
            <data android:mimeType="image/*"/>
        </intent>
    </queries>
    <application
        android:networkSecurityConfig="@xml/network_security_config"
        android:allowBackup="false"
        android:label="SpektraLab"
        android:icon="@mipmap/ic_launcher"
        android:theme="@style/AppTheme"
        android:hardwareAccelerated="true"
        android:largeHeap="true">
        <activity android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:scheme="content"/>
                <data android:scheme="file"/>
                <data android:mimeType="image/*"/>
            </intent-filter>
        </activity>
    </application>
</manifest>
