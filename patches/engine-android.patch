+// sigma under `kMinEffectiveBlurSigma`).
+bool Pipeline::grain_dye_sigma(double sigma_out[3][3]) const {
+    const GrainParams& g = params_.film_render.grain;
+    for (int sl = 0; sl < 3; ++sl)
+        for (int ch = 0; ch < 3; ++ch) sigma_out[sl][ch] = 0.0;
+    if (!g.active || g.amount <= 0.0) return false;
+    if (!g.sublayers_active) return false;
