+    const float v = mx;
+
+    // Table entries are degrees, at 0, 7.5, ... 352.5.
+    const float x = h / 7.5;
+    const int i0 = int(floor(x));
+    const float f = x - float(i0);
+    const int a = i0 % 48;
+    const int b = (i0 + 1) % 48;
+    // **Six tables: 3 brightness levels x 2 saturation levels, bilinear.**
+    //
+    // The drift depends on both. At V=0.50 the same 30 degree orange needs
+    // -3.2 degrees at S=0.30 and +9.9 at S=0.75 -- so one table measured on
+    // saturated patches over-corrects skin by ~10 degrees, which is exactly the
+    // "hands and wooden desk picked up a green cast" report. Brightness still
+    // moves the sign, so it cannot be folded into saturation either.
+    // Extrapolating below the lowest measured layer on purpose: a photograph's
+    // greens sit at V ~ 0.18-0.21, under the 0.30 patch the darkest table was
+    // measured at.
+    const float vv = clamp(v, 0.10, 0.72);
