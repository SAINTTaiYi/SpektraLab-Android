diff --git a/engine/src/shaders/vulkan/spk_mask_epilogue.comp b/engine/src/shaders/vulkan/spk_mask_epilogue.comp
new file mode 100644
index 0000000..aefbf67
--- /dev/null
+++ b/engine/src/shaders/vulkan/spk_mask_epilogue.comp
@@ -0,0 +1,119 @@
+#version 450
+
+// RFC-024's virtual contrast mask, the application half.
+//
+// This kernel is the unmasked print path's spectral integral with one change in
+// the epilogue: the image exposure is multiplied by the mask's gain **before**
+// the pre-flash offset is added.
+//
+//     today:   E = max(a * gain + flash, 0) + 1e-10
+//     masked:  E = max(2^delta * (a * gain) + flash, 0) + 1e-10
+//
+// which is RFC-024 §4's `P * [2^delta * A + F]` with `P` left to the existing
+// `spk_print_exposure` node.
+//
+// `delta` is read off the *base* (a Gaussian blur of the mask's own coordinate
+// `x`, on a canonical grid): a base below the core is a highlight of the scene
+// -- a negative's exposure is inverted -- and gains exposure, a base above it is
+// a shadow and loses some. Local detail (the difference between `x` and its
+// blur) is never touched, which is what makes this a darkroom dodging/burning
+// and not a global curve.
+//
+// Ported from `contrast_mask.metal`.
+layout(local_size_x = 256) in;
+
+layout(set = 0, binding = 0, std430) readonly buffer Cmy { float value[]; } cmy;
+layout(set = 0, binding = 1, std430) readonly buffer Chd { float value[]; } chd;
+layout(set = 0, binding = 2, std430) readonly buffer Base { float value[]; } base_data;
+layout(set = 0, binding = 3, std430) readonly buffer Ixs { float value[]; } ixs;
+layout(set = 0, binding = 4, std430) readonly buffer Params { float value[]; } p;
+layout(set = 0, binding = 5, std430) readonly buffer Coef { float value[]; } coef;
+layout(set = 0, binding = 6, std430) readonly buffer Meta { uint value[]; } meta;
+layout(set = 0, binding = 7, std430) writeonly buffer Out { float value[]; } out_data;
+
+// base   this dispatch's first element inside its binding window
+// origin where that window starts in the frame (absolute index = origin + base + local)
+// read_bias how many elements the window starts before the band
+layout(push_constant) uniform SpkDispatch { uint base; uint origin; uint read_bias; } spk_pc;
+
+const float kMaskLog2Floor = -20.0;
+
+uint spk_global_index() {
+    return spk_pc.base + gl_GlobalInvocationID.y * (gl_NumWorkGroups.x * gl_WorkGroupSize.x)
+         + gl_GlobalInvocationID.x;
+}
+
+vec3 mask_image_exposure(uint i, uint nl) {
+    float c0 = cmy.value[3u * i];
+    float c1 = cmy.value[3u * i + 1u];
+    float c2 = cmy.value[3u * i + 2u];
+    float a0 = 0.0, a1 = 0.0, a2 = 0.0;
+    for (uint l = 0u; l < nl; ++l) {
+        float d = c0 * chd.value[3u * l] + c1 * chd.value[3u * l + 1u] + c2 * chd.value[3u * l + 2u]
+                + base_data.value[l];
+        float t = exp2(-d * 3.321928094887362);
+        a0 += t * ixs.value[3u * l];
+        a1 += t * ixs.value[3u * l + 1u];
+        a2 += t * ixs.value[3u * l + 2u];
+    }
+    return vec3(a0 * p.value[0], a1 * p.value[1], a2 * p.value[2]);
+}
+
+float mask_x(vec3 a) {
+    float s = 0.0;
+    for (uint c = 0u; c < 3u; ++c) {
+        float r = max(a[c] * p.value[3u + c], 0.0);
+        s += max(log2(r), kMaskLog2Floor);
+    }
+    return s * (1.0 / 3.0);
+}
+
+// RFC-023's m = 2 branch, `D * H / sqrt(H^2 + D^2)`: slope 1 at the knee,
+// asymptote H.
+float mask_g(float d, float h) { return d * h * inversesqrt(h * h + d * d); }
+
+// delta = f(b) - b, bounded. Exactly 0.0 inside the core and on a disabled
+// branch, so the gain there is exp2(0) = 1.
+float mask_delta(float b) {
+    float delta = 0.0;
+    if (p.value[11] != 0.0 && b < p.value[9]) {
+        float d = p.value[9] - b;
+        delta = d - mask_g(d, p.value[10]);
+    } else if (p.value[14] != 0.0 && b > p.value[12]) {
+        float d = b - p.value[12];
+        delta = mask_g(d, p.value[13]) - d;
+    }
+    // The same smooth-min bounds the gain itself (RFC-023 §15's fix for an
+    // unbounded shadow gain): |delta| < limit for any base.
+    float lim = p.value[15];
+    return delta * lim * inversesqrt(lim * lim + delta * delta);
+}
+
+void main() {
+    uint n = meta.value[0], nl = meta.value[1], W = meta.value[2], H = meta.value[3];
+    uint row0 = meta.value[4], gw = meta.value[5], gh = meta.value[6];
+    uint i = spk_global_index();
+    if (i >= n) return;
+    vec3 a = mask_image_exposure(i, nl);
+
+    uint px = i % W, py = row0 + i / W;
+    float u = clamp((float(px) + 0.5) * float(gw) / float(W) - 0.5, 0.0, float(gw - 1u));
+    float v = clamp((float(py) + 0.5) * float(gh) / float(H) - 0.5, 0.0, float(gh - 1u));
+    uint u0 = uint(floor(u)), v0 = uint(floor(v));
+    uint u1 = min(u0 + 1u, gw - 1u), v1 = min(v0 + 1u, gh - 1u);
+    float tu = u - float(u0), tv = v - float(v0);
+    vec2 c00 = vec2(coef.value[2u * (v0 * gw + u0)], coef.value[2u * (v0 * gw + u0) + 1u]);
+    vec2 c01 = vec2(coef.value[2u * (v0 * gw + u1)], coef.value[2u * (v0 * gw + u1) + 1u]);
+    vec2 c10 = vec2(coef.value[2u * (v1 * gw + u0)], coef.value[2u * (v1 * gw + u0) + 1u]);
+    vec2 c11 = vec2(coef.value[2u * (v1 * gw + u1)], coef.value[2u * (v1 * gw + u1) + 1u]);
+    vec2 ab = mix(mix(c00, c01, tu), mix(c10, c11, tu), tv);
+
+    float b = ab.x * mask_x(a) + ab.y;
+    float k = exp2(mask_delta(b));
+    float v0e = max(k * a.x + p.value[6], 0.0) + 1e-10;
+    float v1e = max(k * a.y + p.value[7], 0.0) + 1e-10;
+    float v2e = max(k * a.z + p.value[8], 0.0) + 1e-10;
+    out_data.value[3u * i]     = log(v0e) * 0.4342944819032518;
+    out_data.value[3u * i + 1] = log(v1e) * 0.4342944819032518;
+    out_data.value[3u * i + 2] = log(v2e) * 0.4342944819032518;
+}
diff --git a/engine/src/shaders/vulkan/spk_mask_reduce.comp b/engine/src/shaders/vulkan/spk_mask_reduce.comp
new file mode 100644
index 0000000..65c264a
--- /dev/null
+++ b/engine/src/shaders/vulkan/spk_mask_reduce.comp
@@ -0,0 +1,72 @@
+#version 450
+
+// RFC-024's virtual contrast mask, the analysis half.
+//
+// One invocation per grid cell: the mean of `x` over the cell's pixels, where
+// `x` is the equal-weight mean over the three paper channels of
+// `log2(A_c / A_ref_c)` -- the negative's own mid-grey through this enlarger
+// is `x = 0`. The cells partition the frame, so every pixel is counted exactly
+// once whatever the tier's size.
+//
+// Ported from `contrast_mask.metal`; `p` is the one block both halves read:
+//   0..2  the enlarger's setup gain (image exposure only)
+//   3..5  1 / A_ref
+//   6..8  the pre-flash offset (epilogue only)
+//   9 k_lo  10 h_lo  11 lo_on    -- the print-highlight branch
+//   12 k_hi 13 h_hi  14 hi_on    -- the print-shadow branch
+//   15 the gain limit, stops
+layout(local_size_x = 256) in;
+
+layout(set = 0, binding = 0, std430) readonly buffer Cmy { float value[]; } cmy;
+layout(set = 0, binding = 1, std430) readonly buffer Chd { float value[]; } chd;
+layout(set = 0, binding = 2, std430) readonly buffer Base { float value[]; } base_data;
+layout(set = 0, binding = 3, std430) readonly buffer Ixs { float value[]; } ixs;
+layout(set = 0, binding = 4, std430) readonly buffer Params { float value[]; } p;
+layout(set = 0, binding = 5, std430) readonly buffer Meta { uint value[]; } meta;
+layout(set = 0, binding = 6, std430) writeonly buffer Out { float value[]; } out_data;
+
+// The floor under `log2`, relative to mid-grey: 2^-20 is ~6 densities below
+// it, far under any paper's toe. It is a numerical guard, not a signal -- a
+// pixel that lands on it gets a bounded gain from the curve like any other.
+const float kMaskLog2Floor = -20.0;
+
+vec3 mask_image_exposure(uint i, uint nl) {
+    float c0 = cmy.value[3u * i];
+    float c1 = cmy.value[3u * i + 1u];
+    float c2 = cmy.value[3u * i + 2u];
+    float a0 = 0.0, a1 = 0.0, a2 = 0.0;
+    for (uint l = 0u; l < nl; ++l) {
+        float d = c0 * chd.value[3u * l] + c1 * chd.value[3u * l + 1u] + c2 * chd.value[3u * l + 2u]
+                + base_data.value[l];
+        float t = exp2(-d * 3.321928094887362);
+        a0 += t * ixs.value[3u * l];
+        a1 += t * ixs.value[3u * l + 1u];
+        a2 += t * ixs.value[3u * l + 2u];
+    }
+    return vec3(a0 * p.value[0], a1 * p.value[1], a2 * p.value[2]);
+}
+
+float mask_x(vec3 a) {
+    float s = 0.0;
+    for (uint c = 0u; c < 3u; ++c) {
+        float r = max(a[c] * p.value[3u + c], 0.0);
+        s += max(log2(r), kMaskLog2Floor);
+    }
+    return s * (1.0 / 3.0);
+}
+
+void main() {
+    uint W = meta.value[0], H = meta.value[1], gw = meta.value[2], gh = meta.value[3];
+    uint nl = meta.value[4];
+    uint cell = gl_GlobalInvocationID.x;
+    if (cell >= gw * gh) return;
+    uint cy = cell / gw, cx = cell % gw;
+    uint x0 = (cx * W) / gw, x1 = max(((cx + 1u) * W) / gw, x0 + 1u);
+    uint y0 = (cy * H) / gh, y1 = max(((cy + 1u) * H) / gh, y0 + 1u);
+    x1 = min(x1, W); y1 = min(y1, H);
+    float acc = 0.0;
+    for (uint y = y0; y < y1; ++y)
+        for (uint x = x0; x < x1; ++x)
+            acc += mask_x(mask_image_exposure(y * W + x, nl));
+    out_data.value[cell] = acc / float((x1 - x0) * (y1 - y0));
+}
