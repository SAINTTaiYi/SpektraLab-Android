+// A row-banded dispatch: the same kernel over the same buffers, one band of
+// `band_rows` rows at a time, each band named through its own binding window.
+//
+// The output is bit-identical to a single whole-frame dispatch. A band's
+// arguments are windowed to exactly the rows it writes, and the shader's
+// push-constant base restarts at 0 inside each window, so spk_global_index()
+// addresses the band from its first element -- which is what makes a frame
+// larger than maxStorageBufferRange renderable at all.
+//
+// `stride[i]` is bytes per element for argument i; 0 means "not a per-element
+// buffer" (weights, metadata) and stays bound whole. A band may only start on
+// a row where `first_row * columns * stride` is a multiple of the device's
+// minStorageBufferOffsetAlignment for every windowed argument, so the backend
+// rounds the band size up until that holds.
+struct TilePlan {
+    uint32_t rows = 0;
+    uint32_t columns = 0;
+    uint32_t band_rows = 0;
+    std::vector<uint32_t> stride;
+    // Rows of neighbouring data an argument's window must also expose. A halo
+    // argument's window starts `halo` rows above the band (clipped at the top);
+    // the band still writes only its own rows, and the shader reaches the extra
+    // rows at `i + read_bias`, where read_bias is (band_start - window_start)
+    // elements. Every halo argument shares one window start, so one bias serves
+    // them all.
+    std::vector<uint32_t> halo;
+};
