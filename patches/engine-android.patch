diff --git a/engine/src/shaders/vulkan/spk_canary.comp b/engine/src/shaders/vulkan/spk_canary.comp
new file mode 100644
index 0000000..362ff12
--- /dev/null
+++ b/engine/src/shaders/vulkan/spk_canary.comp
@@ -0,0 +1,25 @@
+#version 450
+// spk_canary -- one probe per workgroup, at k * stride uint32 elements.
+//
+// Binding a storage buffer whose range exceeds `maxStorageBufferRange` is not
+// an error the API reports: the descriptor update succeeds, the dispatch
+// succeeds, and the writes past the reported range are simply dropped. This
+// kernel is how that gets measured rather than guessed -- every probe below
+// the limit must come back, and the ones above are the answer.
+//
+// local_size_x = 1 because a probe is one word; the workgroup index is the
+// probe index, which keeps the addressing out of the shader's arithmetic.
+layout(local_size_x = 1) in;
+
+layout(push_constant) uniform SpkDispatch {
+    uint base;    // unused here: probes are not part of a frame
+    uint origin;  // unused here
+    uint bias;    // probe spacing in uint32 elements
+} pc;
+
+layout(std430, binding = 0) buffer Dst { uint data[]; };
+
+void main() {
+    uint k = gl_WorkGroupID.x;
+    data[k * pc.bias] = 0xAB000000u | k;
+}
