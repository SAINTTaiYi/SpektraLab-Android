--- /dev/null
+++ b/engine/src/shaders/vulkan/spk_highlights_only.comp
@@ -0,0 +1,21 @@
+#version 450
+
+// `max(src - threshold, 0)`, per channel: the part of a frame bright enough to
+// throw a halo. Halation is light the film got *back*, so it has to be built
+// from the highlights alone -- mixing a blurred copy of the whole frame back in
+// (what the energy-preserving blend did) is a local average, and reads as
+// softness rather than glow.
+layout(local_size_x = 256) in;
+layout(push_constant) uniform SpkDispatch { uint base; uint origin; uint read_bias; } spk_pc;
+layout(set = 0, binding = 0, std430) readonly buffer Input { float value[]; } src;
+layout(set = 0, binding = 1, std430) readonly buffer Params { float value[]; } p;
+layout(set = 0, binding = 2, std430) readonly buffer Count { uint value[]; } count_data;
+layout(set = 0, binding = 3, std430) writeonly buffer Output { float value[]; } dst;
+
+void main() {
+    uint i = spk_pc.base + gl_GlobalInvocationID.y * (gl_NumWorkGroups.x * gl_WorkGroupSize.x) + gl_GlobalInvocationID.x;
+    if (i >= count_data.value[0]) return;
+    const float t = p.value[i % 3u];
+    const float v = src.value[i] - t;
+    dst.value[i] = v > 0.0 ? v : 0.0;
+}
