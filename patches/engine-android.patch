+// **Keyed by film *and* paper.** The drift is not a property of the film
+// alone: the same C200 shifts green by -1 deg on Crystal Archive and -43 deg on
+// Ultra Endura, so a per-film table would be wrong the moment the paper
+// changes. 17 negatives x 8 colour papers, plus the four reversal stocks that
+// bypass the paper entirely (key ending in '|').
+const float* hue_fix_for(const std::string& key) {
+    for (const auto& row : kHueFix) {
+        // The three layers are contiguous, so the first one's address is the
+        // whole 3 x 48 block the kernel indexes.
+        if (key == row.stock) return row.v0;
+    }
+    return nullptr;
+}
+}  // namespace
+
+bool Pipeline::node_hue_correct(const Image& in, Image& out, std::string& error) {
+    const std::string key = params_.io.scan_film
+            ? params_.film_stock + "|"
+            : params_.film_stock + "|" + params_.print_stock;
+    const float* tbl = hue_fix_for(key);
+    // SPK_NO_HUE_FIX renders the uncorrected frame. The calibration must run
+    // with it on, or the measurement includes the correction it is measuring.
+    const double want = std::min(1.0, std::max(0.0, params_.print_render.hue_correction));
+    if (!tbl || want <= 0.001 || std::getenv("SPK_NO_HUE_FIX")) { out = in; return true; }
+    Timer t(this, "printing.hue_correct");
+    // The strength is a scale on the table, so it costs one 1.1 kB upload and
+    // never a rebuild. `want == 1` still copies, which keeps the two paths
+    // byte-identical instead of trusting tbl to be exactly the same numbers.
+    float scaled[6 * 48];
+    for (int i = 0; i < 6 * 48; ++i) scaled[i] = float(tbl[i] * want);
+    gpu::BufferRef tb = gpu_->upload(scaled, sizeof scaled, error);
+    if (!tb) return false;
+    if (!alloc_like(in, out, error)) return false;
+    const uint32_t n[1] = {uint32_t(in.pixels())};
+    return dispatch_plane("spk_hue_correct",
+                          {gpu::Arg::buf(in.buf), gpu::Arg::buf(tb),
+                           gpu::Arg::inline_bytes(n, 1), gpu::Arg::buf(out.buf)},
+                          {in.c * 4u, 0u, 0u, in.c * 4u}, in, in.pixels(), error);
 }
 
