+        {"device lost", 1004},
+        {"no Vulkan loader", 1005},
+        {"device limits are below", 1006},
+        {"Vulkan kernel not ported", 1007},
+        {"invalid Vulkan", 1008},
+        {"Vulkan ", 1009},
+        {"RAW open", 1101},
+        {"RAW unpack", 1102},
+        {"RAW process", 1103},
+        {"RAW output", 1104},
+        {"RAW headroom", 1105},
+        {"RAW decode", 1106},
+        {"not ported", 1201},
+        {"render produced no pixels", 1202},
+        {"empty frame", 1202},
+        {"unknown stock", 1301},
+        {"bad stock", 1301},
+        {"outside [", 1302},
+        {"is outside", 1302},
+        {"unknown tier", 1302},
+        {"session", 1303},
