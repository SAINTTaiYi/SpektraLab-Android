 namespace spk::gpu {
 
+namespace {
+// Debug channel: an app cannot read stderr, so the same diagnostics can go to a
+// file named by SPK_VK_LOG instead. Dormant unless that variable is set.
+FILE* spk_vk_log_file() {
+    static FILE* file = nullptr;
+    static bool tried = false;
+    if (!tried) {
+        tried = true;
+        const char* path = std::getenv("SPK_VK_LOG");
+        if (path && *path) file = std::fopen(path, "a");
+    }
+    return file;
+}
+void spk_vk_log(const char* fmt, ...) {
+    FILE* file = spk_vk_log_file();
+    if (!file) return;
+    va_list ap;
+    va_start(ap, fmt);
+    std::vfprintf(file, fmt, ap);
+    va_end(ap);
+    std::fputc('\n', file);
+    std::fflush(file);
+}
