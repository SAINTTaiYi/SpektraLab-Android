+// **The vendor's own display intent, which LibRaw never reads.**
+//
+// A phone that writes a DNG can ship `ProfileToneCurve` (50940): a list of
+// (x, y) floats mapping scene-linear to the tone-mapped space the vendor wants
+// the picture read in. Together with `BaselineExposure` (50730, EV) it is the
+// whole of "how this phone wants its raw displayed", and it is why a OnePlus
+// frame reads flat here and developed in Lightroom.
+//
+// Measured on /sdcard/Download/QQ/IMG20260519180017.dng: the curve maps 0.0144
+// (the frame's own median) to 0.0086, 0.10 to 0.137 and 0.30 to 0.498 -- an S
+// that pulls the mids down and the upper mids up. Applied to our decode it
+// moved p95 from 149 to 188.4 against Lightroom's 187.7.
+//
+// Both tags are optional and absent from every camera DNG and every NEF/RAF
+// tested, so a false return means "render it the way we always did".
+bool read_dng_display_profile(const std::filesystem::path& source,
+                              std::vector<float>& tone_curve,
+                              double& baseline_exposure) {
+    tone_curve.clear();
+    baseline_exposure = 0.0;
+    std::FILE* f = std::fopen(source.c_str(), "rb");
+    if (!f) return false;
+    unsigned char hdr[8];
+    if (std::fread(hdr, 1, 8, f) != 8) { std::fclose(f); return false; }
+    const bool ii = hdr[0] == 'I' && hdr[1] == 'I';
+    const bool mm = hdr[0] == 'M' && hdr[1] == 'M';
+    if (!ii && !mm) { std::fclose(f); return false; }
+    auto rd16 = [&](const unsigned char* p) {
+        return ii ? std::uint16_t(p[0] | (p[1] << 8)) : std::uint16_t((p[0] << 8) | p[1]);
+    };
+    auto rd32 = [&](const unsigned char* p) {
+        return ii ? (std::uint32_t(p[0]) | (std::uint32_t(p[1]) << 8) |
+                     (std::uint32_t(p[2]) << 16) | (std::uint32_t(p[3]) << 24))
+                  : ((std::uint32_t(p[0]) << 24) | (std::uint32_t(p[1]) << 16) |
+                     (std::uint32_t(p[2]) << 8) | std::uint32_t(p[3]));
+    };
+    auto rdf32 = [&](const unsigned char* p) {
+        const std::uint32_t u = rd32(p);
+        float v = 0.0f;
+        std::memcpy(&v, &u, 4);
+        return v;
+    };
+    const std::uint32_t ifd = rd32(hdr + 4);
+    if (!ifd) { std::fclose(f); return false; }
+    if (std::fseek(f, long(ifd), SEEK_SET) != 0) { std::fclose(f); return false; }
+    unsigned char nb[2];
+    if (std::fread(nb, 1, 2, f) != 2) { std::fclose(f); return false; }
+    const std::uint16_t n = rd16(nb);
+    if (n == 0 || n > 512) { std::fclose(f); return false; }
+    // Slurp the entry table: two tags are wanted, and seeking to one payload
+    // would lose the position for the other.
+    std::vector<unsigned char> tab(static_cast<size_t>(n) * 12u);
+    if (std::fread(tab.data(), 1, tab.size(), f) != tab.size()) { std::fclose(f); return false; }
+
+    bool got_curve = false;
+    for (std::uint16_t i = 0; i < n; ++i) {
+        const unsigned char* e = tab.data() + size_t(i) * 12;
+        const std::uint16_t tag = rd16(e);
+        const std::uint16_t typ = rd16(e + 2);
+        const std::uint32_t cnt = rd32(e + 4);
+        const std::uint32_t val = rd32(e + 8);
+        if (tag == 0xC6FC && typ == 11 && cnt >= 4 && cnt <= 8192 && (cnt % 2) == 0) {
+            std::vector<unsigned char> buf(static_cast<size_t>(cnt) * 4u);
+            if (std::fseek(f, long(val), SEEK_SET) != 0) continue;
+            if (std::fread(buf.data(), 1, buf.size(), f) != buf.size()) continue;
+            std::vector<float> flat(static_cast<size_t>(cnt));
+            bool ok = true;
+            for (std::uint32_t k = 0; k < cnt; ++k) {
+                const float v = rdf32(buf.data() + size_t(k) * 4);
+                if (!std::isfinite(v)) { ok = false; break; }
+                flat[k] = v;
+            }
+            if (ok) {
+                // **Some writers interleave a stray 0.0 into the list.**
+                // OPPO does it every 11 values, which shifts every pair after
+                // it: the x list then reads 0.0315 -> 0.0000 -> 0.0360 and the
+                // (x, y) pairing is lost for the rest of the curve. Reading
+                // such a file with a plain stride gives 25 non-monotonic
+                // steps and a curve that is not a function at all.
+                //
+                // Rebuild from the flat list, accepting a pair only when both
+                // components advance. A DNG tone curve is monotonic in both by
+                // definition, so a legitimate pair always passes and a stray
+                // value never does -- no per-vendor table needed.
+                std::vector<float> pts;
+                pts.reserve(static_cast<size_t>(cnt));
+                double last_x = -1.0, last_y = -1.0;
+                for (std::uint32_t i = 0; i + 1 < cnt; ) {
+                    const float x = flat[i], y = flat[i + 1];
+                    if (double(x) > last_x && double(y) >= last_y) {
+                        pts.push_back(x);
+                        pts.push_back(y);
+                        last_x = x;
+                        last_y = y;
+                        i += 2;
+                    } else {
+                        i += 1;
+                    }
+                }
+                if (pts.size() >= 4) { tone_curve = std::move(pts); got_curve = true; }
+            }
+        } else if (tag == 0xC62A && typ == 10 && cnt == 1) {
+            std::vector<unsigned char> buf(8);
+            if (std::fseek(f, long(val), SEEK_SET) != 0) continue;
+            if (std::fread(buf.data(), 1, 8, f) != 8) continue;
+            const std::int32_t num = std::int32_t(rd32(buf.data()));
+            const std::int32_t den = std::int32_t(rd32(buf.data() + 4));
+            if (den != 0) {
+                const double v = double(num) / double(den);
+                if (std::isfinite(v) && std::fabs(v) < 20.0) baseline_exposure = v;
+            }
+        }
+    }
+    std::fclose(f);
+    return got_curve;
+}
