+            // starting with such a component was `1 + (n_iir - 1) * w` times too
+            // bright.
+            if (is_fir(sg)) continue;
+            double b4[4];
+            yvv_coeffs(sg, b4);
+            for (int j = 0; j < 4; ++j) {
+                const auto hl = split(b4[j]);
+                coef[8 * ch + 2 * j] = hl.first;
+                coef[8 * ch + 2 * j + 1] = hl.second;
+            }
+            act[ch] = 1;
+        }
+        const float w[3] = {float(components[i].weight[0]), float(components[i].weight[1]),
+                            float(components[i].weight[2])};
+        coefs[i] = gpu_->upload(coef, sizeof coef, error);
+        acts[i] = gpu_->upload_u32(act, 3, error);
+        wts[i] = gpu_->upload(w, sizeof w, error);
+        if (!coefs[i] || !acts[i] || !wts[i]) return false;
+    }
+
+    const size_t state_lines = std::max<size_t>(1, std::max(img.w, img.h));
+    const size_t slot_words = state_lines * 3u * 6u;
+    const size_t h_slot = size_t(bands);
+    const size_t bwd_slot = size_t(bands) + 1u;
+    const size_t slots_per_comp = size_t(bands) + 2u;
+    gpu::BufferRef state =
+        gpu_->alloc(size_t(n_comp) * slots_per_comp * slot_words * sizeof(float), error);
+    if (!state) return false;
+
+    const uint64_t band_bytes = uint64_t(band) * row_bytes;
+    gpu::BufferRef fwd_buf = gpu_->alloc(band_bytes, error);   // horizontal + replay forward
+    if (!fwd_buf) return false;
+
+    // **The traversal\'s input, when it is produced rather than held.** `img`
+    // is then only its shape: `src_band` carries `[y0 - src_top, y0 + rows +
+    // src_bot)` for the band under work, regenerated for every band and for
+    // both traversals. Every read of `img` below goes through it. That is what
+    // lets a stage whose input is itself a pointwise function of another plane
+    // -- `curve(log)` fed to a diffusion -- stop holding that input whole: at a
+    // 58 MP canvas the plane it saves is 660 MiB, and the arithmetic per element
+    // is untouched, so the result is bit for bit the same.
+    const uint32_t src_pad = make ? uint32_t(((max_halo + 63u) / 64u) * 64u) : 0u;
+    gpu::BufferRef src_band;
+    // **The rows the sweep above has already replaced.** The backward traversal
+    // runs bottom to top and writes its answer over `out` band by band, so by
+    // the time a band is reached its lower halo belongs to a band that is
+    // already finished. `save` carries those rows as they were, and the band
+    // that needs them is the only reader. One band of rows, not a plane.
+    gpu::BufferRef save_buf;
+    uint32_t saved_rows = 0;
+    uint32_t src_top = 0;
+    auto build_src = [&](uint32_t y0, uint32_t rows, bool lower_from_save) -> bool {
+        src_top = std::min(src_pad, y0);
+        const uint32_t src_bot = std::min(src_pad, uint32_t(img.h) - (y0 + rows));
+        const uint32_t src_rows = rows + src_top + src_bot;
+        if (!src_band) {
+            // One launch window per band, and every launch inside it starts on a
+            // 64-row boundary -- the window a binding sees has to be a multiple
+            // of minStorageBufferOffsetAlignment, and 64 rows of a 12-byte pixel
+            // always is.
+            src_band = gpu_->alloc(uint64_t(band + 2u * src_pad) * row_bytes, error);
+            if (!src_band) return false;
+        }
+        Image sb;
+        sb.w = img.w; sb.h = src_rows; sb.c = 3; sb.buf = src_band;
+        if (!(*make)(y0 - src_top, src_rows, sb, error)) return false;
+        if (lower_from_save && src_bot > 0 && saved_rows >= src_bot) {
+            if (!gpu_->copy(src_band.get(), uint64_t(src_top + rows) * row_bytes,
+                            save_buf.get(), 0u, uint64_t(src_bot) * row_bytes, error))
+                return false;
+        }
+        return true;
+    };
+
+    if (make && src_pad > 0u && !save_buf) {
+        save_buf = gpu_->alloc(uint64_t(src_pad) * row_bytes, error);
+        if (!save_buf) return false;
+    }
+
+    // The halo scratch, only when a component needs one.
+    const uint32_t ext_rows = band + 2u * (make ? src_pad : max_halo);
+    const uint64_t ext_bytes = uint64_t(ext_rows) * row_bytes;
+    // `gbuf` used to be allocated here and never read: one band-sized block per
+    // mixture, alive for the whole traversal.
+    gpu::BufferRef ext_buf, extout_buf, mid_buf;
+    if (max_halo > 0u) {
+        ext_buf = gpu_->alloc(ext_bytes, error);
+        extout_buf = gpu_->alloc(ext_bytes, error);
+        mid_buf = gpu_->alloc(band_bytes, error);
+    }
+    if (max_halo > 0u && (!ext_buf || !extout_buf || !mid_buf)) return false;
+
+    // Writing through the input costs nothing when the halos allow it. When they
+    // do not, one fresh plane is still two fewer than declining would have cost.
+    if (!subtract_from_out && !write_through &&
+        !(reuse_out && out.buf && out.buf.get() != img.buf.get() && out.w == img.w &&
+          out.h == img.h && out.c == img.c)) {
+        out.h = img.h; out.w = img.w; out.c = 3;
+        out.buf = gpu_->alloc(out.bytes(), error);
+        if (!out.buf) return false;
+    }
+
+    // The band the traversal's sum lands in when it is going to be taken off
+    // `out`; one band, not one plane.
+    gpu::BufferRef band_out;
+    gpu::BufferRef one_buf, minus_one_buf;
+    if (subtract_from_out) {
+        band_out = gpu_->alloc(band_bytes, error);
+        if (!band_out) return false;
+        // `out = out * take_a + band * take_b` per channel. Subtraction is
+        // `1, -1`; halation's scatter is a blend, `1 - amount, amount`. A
+        // pointwise pair, so a band of it is the same arithmetic the whole-plane
+        // `lincomb` would have done on the same operands.
+        float fa[3] = {1.0f, 1.0f, 1.0f}, fb[3] = {-1.0f, -1.0f, -1.0f};
+        if (take_a) for (int c = 0; c < 3; ++c) fa[c] = float(take_a[c]);
+        if (take_b) for (int c = 0; c < 3; ++c) fb[c] = float(take_b[c]);
+        one_buf = gpu_->upload(fa, sizeof fa, error);
+        minus_one_buf = gpu_->upload(fb, sizeof fb, error);
+        if (!one_buf || !minus_one_buf) return false;
+    }
+
+    gpu::BufferRef gate_buf;
+    if (gate) {
+        const float th[3] = {float(gate[0]), float(gate[1]), float(gate[2])};
+        gate_buf = gpu_->upload(th, sizeof th, error);
+        if (!gate_buf) return false;
+    }
+
+    // **The halo band, built once and used by both traversals.** Rows
+    // `[y0 - top, y0 + rows + bot)` of the input are copied into `ext`, gated if
+    // the caller asked for the additive form, blurred by `fir`, and the middle
+    // `rows` are left in `mid` -- which then plays the part `img` plays for an
+    // IIR-only component.
+    auto make_mid = [&](uint32_t i, uint32_t y0, uint32_t rows) -> bool {
+        // In `make` mode the copy comes from `src_band`, whose origin is
+        // already `y0 - src_top`; using the padded radius keeps `top == src_top`
+        // so the source offset is zero, and keeps every launch 64-row aligned.
+        const uint32_t R = make ? src_pad : halo_of[i];
+        const uint32_t top = std::min(R, y0);
+        const uint32_t bot = std::min(R, uint32_t(img.h) - (y0 + rows));
+        const uint32_t er = rows + top + bot;
+        const uint64_t ebytes = uint64_t(er) * row_bytes;
+        if (!gpu_->copy(ext_buf.get(), 0u, (make ? src_band : img.buf).get(),
+                        (make ? 0u : uint64_t(y0 - top) * row_bytes), ebytes, error))
+            return false;
+        Image ext;
+        ext.h = er; ext.w = img.w; ext.c = 3; ext.buf = ext_buf;
+        if (gate_buf) {
+            const uint32_t gn[1] = {uint32_t(er) * img.w * 3u};
+            if (!dispatch_tiled(gpu_, "spk_highlights_only",
+                                {gpu::Arg::buf(ext_buf), gpu::Arg::buf(gate_buf),
+                                 gpu::Arg::inline_bytes(gn, 1), gpu::Arg::buf(ext_buf)},
+                                {4u, 0u, 0u, 4u}, ext, ext.elements(), error)) return false;
+        }
+        Image eo;
+        eo.h = er; eo.w = img.w; eo.c = 3; eo.buf = extout_buf;
+        if (!fir(ext, components[i].sigma, truncate, fir_act[i].data(), eo, error,
+                 nullptr, nullptr, /*reuse_out=*/true, /*weight_only=*/false)) return false;
+        // The middle rows are the ones whose support lies inside the copy.
+        return gpu_->copy(mid_buf.get(), 0u, extout_buf.get(), uint64_t(top) * row_bytes,
+                          uint64_t(rows) * row_bytes, error);
+    };
+
+    // **How many lines one launch carries.** This was the kernel's workgroup
+    // size, 256, which is not a budget -- it is the smallest a launch can be.
+    // A vertical sweep has one thread per column and the recurrence is serial
+    // down each column, so a 256-thread launch is eight warps on a GPU with
+    // dozens of slots and nothing else to fill them: measured at a 33.8 MP
+    // canvas, halation's three IIR components took 18.7 s where the same
+    // arithmetic spread over 1024 columns takes a quarter of that. The step is
+    // a multiple of 256 because a dispatch is rounded up to whole workgroups and
+    // the kernel has no upper bound on `line` -- surplus threads would work on
+    // the next chunk's columns. Arithmetic per element is unchanged, so this is
+    // a scheduling change and the output is bit for bit what it was.
+    constexpr uint32_t kLinesPerLaunch = 256;   // == the kernel's local_size_x
+    // One launch is bounded by the elements it walks, and a thread walks a
+    // whole line: `img.w * 3` floats for a horizontal sweep, one band of rows
+    // for a vertical one. Dividing by the frame's *line count* instead (the
+    // first cut of this) left the horizontal sweep pinned at 256 rows on every
+    // large frame, which is eight warps for a pass that has six thousand
+    // independent lines to hand out.
+    // **16 M elements per launch, measured.** A size sweep at a 57.7 MP canvas:
+    // 12 M -> 41.9 s, 16 M -> 31.9 s, 20 M -> 31.9 s, 26 M -> 34.1 s, 32 M ->
+    // 43.5 s, 48 M -> 45.9 s, 64 M -> DEVICE_LOST. The curve is not monotonic
+    // because a wider launch trades warp occupancy against cache residency, and
+    // the flat spot is 16-20 M; 16 M keeps a 4x margin to the loss point.
+    // Deliberately a separate knob from `SPK_IIR_MAX_ELEMS`: that one bounds the
+    // whole-plane sweep, which was tuned against a different failure.
+    static const uint64_t kLaunchElementBudget = [] {
+        if (const char* v = std::getenv("SPK_IIR_BAND_ELEMS")) return uint64_t(std::atoll(v));
+        if (const char* v = std::getenv("SPK_IIR_MAX_ELEMS")) return uint64_t(std::atoll(v));
+        return uint64_t(16) << 20;
+    }();
+    // **Three lanes per line here too, and this caller did not have it.**
+    //
+    // `iir()` gained the interleaved mapping (adjacent lanes on adjacent
+    // channels) and grew its `meta` to seventeen words to say so. This
+    // function's `launch` kept sixteen words and `n` threads -- so the
+    // shader read `meta[16]` past the end of the binding, and whatever it
+    // found decided whether the dispatch ran interleaved. It usually read
+    // non-zero, which made it interleave a launch that had been sized for
+    // the old mapping: one third of the columns, the other two thirds never
+    // touched, and a band boundary that could not reproduce the plane.
+    //
+    // Measured before the fix, a 5000x5020 plane with `band = 512`:
+    // 25.90 % of the pixels differed from the whole-plane sweep, max 102/255,
+    // and every differing row sat within `band / 2` of a band edge -- which
+    // is exactly the footprint of a column recurrence whose carry was
+    // recorded by a launch that only walked a third of its columns.
+    //
+    // The budget is unchanged: `launch_step` still divides the element
+    // budget by a whole line of three channels, and `n * 3` threads walk
+    // exactly that. `SPK_IIR_INTERLEAVE=0` restores the old mapping.
+    static const bool mix_interleave_wanted = [] {
+        const char* v = std::getenv("SPK_IIR_INTERLEAVE");
+        return !(v && std::atoi(v) == 0);
+    }();
+    const bool mix_channel_batch =
+        uint64_t(img.w) * uint64_t(img.h) * 3ull <= kLaunchElementBudget;
+    const bool mix_interleave = !mix_channel_batch && mix_interleave_wanted;
+    // **One launch covers all three channels when the mapping is interleaved.**
+    // The shader derives `channel` from `t % 3` (that is what makes a launch's
+    // addresses coalesce), so it *ignores* `meta[6]`. Looping the three
+    // channels here anyway ran every element three times -- harmless for a
+    // write-only pass, but an accumulating one (`accumulate == 1`) added its
+    // weight three times instead of once. Measured on a uniform 0.5 plane,
+    // 5000x2000, two IIR components of weight 0.5: 1.0 instead of 0.5.
+    // `iir()` has had `ch_loops` since the interleaved mapping was introduced;
+    // this caller never did.
+    const uint32_t mix_ch_loops = mix_interleave ? 1u : 3u;
+    auto launch_step = [&](uint32_t axis) -> uint32_t {
+        const uint32_t lines = (axis == 1u) ? img.h : img.w;
+        const uint64_t per_thread = (axis == 1u) ? uint64_t(img.w) * 3u
+                                                 : uint64_t(band) * 3u;
+        if (!per_thread || !lines) return lines ? lines : 1u;
+        const uint64_t fit = kLaunchElementBudget / per_thread;
+        const uint64_t step = std::max<uint64_t>(kLinesPerLaunch,
+                                                (fit / kLinesPerLaunch) * kLinesPerLaunch);
+        return uint32_t(std::min<uint64_t>(step, lines));
+    };
+    auto launch = [&](uint32_t i, const gpu::BufferRef& src, uint64_t src_off, uint64_t src_bytes,
+                      const gpu::BufferRef& dst, uint64_t dst_off, uint64_t dst_bytes,
+                      uint32_t axis, uint32_t channel, uint32_t line0, uint32_t lines,
+                      uint32_t y0, uint32_t rows, uint32_t phase, uint32_t carry_fwd,
+                      uint32_t carry_bwd, size_t state_in, size_t state_out,
+                      uint32_t backward_from_input, bool all_channels,
+                      uint32_t accumulate) -> bool {
+        if (line0 >= lines) return true;
+        const uint32_t n = std::min(launch_step(axis), lines - line0);
+        // **Seventeen words, matching `iir()`.** The last one is the mapping
+        // switch the shader branches on; leaving it out is how this caller
+        // silently ran a different mapping from the sweep that sized it.
+        // `batch` stays zero: `all_channels` has no caller that sets it, and
+        // the three channels are walked by the loop outside instead.
+        const uint32_t meta[17] = {img.h, img.w, accumulate, axis,
+                                   uint32_t(state_in * slot_words),
+                                   uint32_t(state_out * slot_words),
+                                   channel, line0, y0, rows,
+                                   carry_fwd, 6u, phase, carry_bwd,
+                                   0u, backward_from_input,
+                                   mix_interleave ? 1u : 0u};
+        (void) all_channels;
+        const bool acc_here = accumulate == 1u;
+        const gpu::BufferRef& accb = acc_here ? dst : src;
+        const uint64_t acco = acc_here ? dst_off : src_off;
+        const uint64_t accbs = acc_here ? dst_bytes : src_bytes;
+        return gpu_->dispatch("spk_iir_df_acc",
+                              {gpu::Arg::window(src, src_off, src_bytes),
+                               gpu::Arg::buf(coefs[i]), gpu::Arg::buf(acts[i]),
+                               gpu::Arg::window(accb, acco, accbs),
+                               gpu::Arg::buf(wts[i]), gpu::Arg::inline_bytes(meta, 17),
+                               gpu::Arg::window(dst, dst_off, dst_bytes),
+                               gpu::Arg::buf(state)},
+                              size_t(n) * (mix_interleave ? 3u : 1u), error);
+    };
+
+    if (std::getenv("SPK_MIX_LOG")) {
+        const gpu::PoolStats ps = gpu_->pool_stats();
+        std::fprintf(stderr, "[mix] start %ux%u band=%u bands=%u halo=%u row=%llu live %.1f total %.1f MiB\n",
+                     img.w, img.h, band, bands, max_halo,
+                     (unsigned long long)row_bytes,
+                     double(ps.live_bytes)/1048576.0, double(ps.total_bytes)/1048576.0);
+    }
+    // --- first traversal: every band forward, remembering where it entered ---
+    for (uint32_t b = 0; b < bands; ++b) {
+        const uint32_t y0 = b * band;
+        const uint32_t rows = std::min(band, img.h - y0);
+        const uint64_t bytes = uint64_t(rows) * row_bytes;
+        const uint64_t off = uint64_t(y0) * row_bytes;
+        if (make && !build_src(y0, rows, /*lower_from_save=*/false)) return false;
+        for (uint32_t i = 0; i < n_comp; ++i) {
+            // **A component with no IIR channel has no state to record.** The
+            // first traversal exists only to know what each band's column
+            // recurrence entered with; a component whose every channel is FIR
+            // (or a delta) never consults it, so running it here was doing the
+            // halo copy and six pass-through launches per band for nothing --
+            // three of halation's four scatter components, on every band, twice
+            // over the frame.
+            if (!needs_iir[i]) continue;
+            const size_t sb = size_t(i) * slots_per_comp;
+            if (needs_fir[i] && !make_mid(i, y0, rows)) return false;
+            const gpu::BufferRef& hin = needs_fir[i] ? mid_buf : (make ? src_band : img.buf);
+            const uint64_t hin_off = needs_fir[i] ? 0u
+                                                  : (make ? uint64_t(src_top) * row_bytes : off);
+            const bool gate_here = gate_buf && !needs_fir[i];
+            if (gate_here) {
+                if (!gpu_->copy(fwd_buf.get(), 0u, (make ? src_band : img.buf).get(),
+                                make ? uint64_t(src_top) * row_bytes : off, bytes, error))
+                    return false;
+                Image band_in;
+                band_in.h = rows; band_in.w = img.w; band_in.c = 3; band_in.buf = fwd_buf;
+                const uint32_t gn[1] = {uint32_t(rows) * img.w * 3u};
+                if (!dispatch_tiled(gpu_, "spk_highlights_only",
+                                    {gpu::Arg::buf(fwd_buf), gpu::Arg::buf(gate_buf),
+                                     gpu::Arg::inline_bytes(gn, 1), gpu::Arg::buf(fwd_buf)},
+                                    {4u, 0u, 0u, 4u}, band_in, band_in.elements(), error))
+                    return false;
+            }
+            const gpu::BufferRef& hsrc = gate_here ? fwd_buf : hin;
+            const uint64_t hsrc_off = gate_here ? 0u : hin_off;
+            for (uint32_t ch = 0; ch < mix_ch_loops; ++ch)
+                for (uint32_t line0 = y0; line0 < y0 + rows; line0 += launch_step(1u))
+                    if (!launch(i, hsrc, hsrc_off, bytes, fwd_buf, 0u, bytes, 1u, ch, line0,
+                                img.h, y0, rows, 0u, 0u, 0u, sb + h_slot, sb + h_slot, 0u, false,
+                                0u)) return false;
+            for (uint32_t ch = 0; ch < mix_ch_loops; ++ch)
+                for (uint32_t line0 = y0; line0 < y0 + rows; line0 += launch_step(1u))
+                    if (!launch(i, fwd_buf, 0u, bytes, fwd_buf, 0u, bytes, 1u, ch, line0,
+                                img.h, y0, rows, 1u, 0u, 0u, sb + h_slot, sb + h_slot, 0u, false,
+                                0u)) return false;
+            for (uint32_t ch = 0; ch < mix_ch_loops; ++ch)
+                for (uint32_t line0 = 0; line0 < img.w; line0 += launch_step(0u))
+                    if (!launch(i, fwd_buf, 0u, bytes, fwd_buf, 0u, bytes, 0u, ch, line0,
+                                img.w, y0, rows, 0u, b > 0u ? 1u : 0u, 0u, sb + b, sb + b + 1u,
+                                0u, false, 0u)) return false;
+        }
+        if (!gpu_->flush(error)) return false;
+    }
+
+    // --- second traversal: replay forward from the recorded entry, sweep home ---
+    uint32_t carry_bwd = 0u;
+    for (uint32_t bi = bands; bi > 0u; --bi) {
+        const uint32_t b = bi - 1u;
+        const uint32_t y0 = b * band;
+        const uint32_t rows = std::min(band, img.h - y0);
+        const uint64_t bytes = uint64_t(rows) * row_bytes;
+        const uint64_t off = uint64_t(y0) * row_bytes;
+        const gpu::BufferRef& dst_buf = subtract_from_out ? band_out : out.buf;
+        const uint64_t dst_off = subtract_from_out ? 0u : off;
+        if (make && !build_src(y0, rows, /*lower_from_save=*/true)) return false;
+        if (make && src_pad > 0u) {
+            // This band's head, **already through the caller's `make`**, is what
+            // the next one down will need for its lower halo -- that band's tail
+            // rows are the same rows of the same source. Saving the raw input
+            // instead would leave the halo corrected while the band it completes
+            // is not. A mixture with no halo at all has nothing to save: every
+            // band reads only its own rows.
+            saved_rows = std::min(src_pad, rows);
+            if (!gpu_->copy(save_buf.get(), 0u, src_band.get(),
+                            uint64_t(src_top) * row_bytes,
+                            uint64_t(saved_rows) * row_bytes, error)) return false;
+        }
+        for (uint32_t i = 0; i < n_comp; ++i) {
+            const size_t sb = size_t(i) * slots_per_comp;
+            if (pointwise[i]) {
+                // `weight * img`, folded straight into the destination: the
+                // kernel's inactive-channel path is exactly `carried + w*image`.
+                const uint32_t acc_mode = (i == 0u && !accumulate) ? 2u : 1u;
+                for (uint32_t ch = 0; ch < mix_ch_loops; ++ch)
+                    for (uint32_t line0 = 0; line0 < img.w; line0 += launch_step(0u))
+                        if (!launch(i, make ? src_band : img.buf,
+                                    make ? uint64_t(src_top) * row_bytes : off, bytes,
+                                    dst_buf, dst_off, bytes, 0u, ch, line0,
+                                    img.w, y0, rows, 0u, 0u, 0u, 0u, 0u, 0u, false, acc_mode))
+                            return false;
+                continue;
+            }
+            if (needs_fir[i] && !make_mid(i, y0, rows)) return false;
+            const gpu::BufferRef& hin = needs_fir[i] ? mid_buf : (make ? src_band : img.buf);
+            const uint64_t hin_off = needs_fir[i] ? 0u
+                                                  : (make ? uint64_t(src_top) * row_bytes : off);
+            const bool gate_here = gate_buf && !needs_fir[i];
+            if (gate_here) {
+                if (!gpu_->copy(fwd_buf.get(), 0u, (make ? src_band : img.buf).get(),
+                                make ? uint64_t(src_top) * row_bytes : off, bytes, error))
+                    return false;
+                Image band_in;
+                band_in.h = rows; band_in.w = img.w; band_in.c = 3; band_in.buf = fwd_buf;
+                const uint32_t gn[1] = {uint32_t(rows) * img.w * 3u};
+                if (!dispatch_tiled(gpu_, "spk_highlights_only",
