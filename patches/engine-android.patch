+    float h;
+    if (mx == rgb.r)      h = mod((rgb.g - rgb.b) / d, 6.0);
+    else if (mx == rgb.g) h = (rgb.b - rgb.r) / d + 2.0;
+    else                  h = (rgb.r - rgb.g) / d + 4.0;
