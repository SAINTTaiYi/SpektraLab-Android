+uint spk_global_index() {
+    return spk_pc.base + gl_GlobalInvocationID.y * (gl_NumWorkGroups.x * gl_WorkGroupSize.x) + gl_GlobalInvocationID.x;
+}
+
+// **Undoing the spectral model's hue drift.**
+//
+// The pipeline turns three stimulus values into a spectrum (`spectra_lut`),
+// pushes that through the film's three layers and the paper's three layers,
+// and integrates back. Recovering a spectrum from three values is
+// underdetermined, so the result depends on which spectrum the LUT picked.
+// Measured against the source, that costs up to 55 degrees of hue on saturated
+// greens and blues -- the "green trees come out yellow" report, quantified.
+//
+// This kernel applies the inverse of that measured drift: 48 hues at 7.5
+// degree steps x 3 brightness levels x 2 saturation levels, indexed by what
+// the frame *has* at this point. It is a
+// correction, not physics. A stock with no table is left exactly as it was.
+//
+// The rotation happens in HSV and the result is rescaled to the pixel's own
+// luminance, because turning a hue in HSV drags V with it and that would make
+// the correction a brightness change as well.
+void main() {
+    const uint i = spk_global_index();
+    if (i >= count_data.value[0]) return;
+    const uint o = i * 3u;
+
+    const vec3 rgb = vec3(input_data.value[o], input_data.value[o + 1u], input_data.value[o + 2u]);
+    const float mx = max(rgb.r, max(rgb.g, rgb.b));
+    const float mn = min(rgb.r, min(rgb.g, rgb.b));
+    const float d = mx - mn;
+    // A neutral has no hue to move; copying it is both cheaper and safer than
+    // dividing by a delta that is numerically zero.
+    if (d <= 1e-7 || mx <= 1e-9) {
+        output_data.value[o] = rgb.r;
+        output_data.value[o + 1u] = rgb.g;
+        output_data.value[o + 2u] = rgb.b;
+        return;
+    }
