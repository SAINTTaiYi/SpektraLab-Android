+    else           { la = 1; lb = 2; tv = (vv - 0.50) / 0.22; }
+    // Two saturation layers, blended by the pixel's own saturation. Measured on
+    // real photographs (not patches) the same green at S=0.35 wants +18 degrees
+    // toward green while at S=0.75 it wants -20; picking one layer for the whole
+    // green band is what made "the greens never change" and "the greens all turn
+    // yellow" both true on different pictures.
+    const float ss = clamp((s - 0.30) / 0.45, 0.0, 1.0);
+    const float l0a = mix(table_data.value[la * 48 + a], table_data.value[la * 48 + b], f);
+    const float l0b = mix(table_data.value[lb * 48 + a], table_data.value[lb * 48 + b], f);
+    const float cl  = mix(l0a, l0b, tv);
+    const float h0a = mix(table_data.value[(3 + la) * 48 + a], table_data.value[(3 + la) * 48 + b], f);
+    const float h0b = mix(table_data.value[(3 + lb) * 48 + a], table_data.value[(3 + lb) * 48 + b], f);
+    const float ch  = mix(h0a, h0b, tv);
+    // **Only the greens -- but all of them.**
+    //
+    // The report that started this was "green trees come out yellow", and the
+    // drift is worst on greens anyway. Rotating the oranges and the blues as
+    // well makes every stock converge on one palette -- the next report was
+    // "the whole engine lost its film character". So the correction is gated
+    // and everything else keeps exactly the colour the stock gave it.
+    //
+    // The window starts at **40**, not 60. A green bottle photographed under
+    // indoor light renders around 50-65 degrees, and the first version of this
+    // gate began at 60 and ramped to 90, which left almost the whole object
+    // untouched -- "开启校色后绿色没什么区别". Skin sits at 30-40 and wood at
+    // 45-50, so the ramp is steep (16 degrees) and the low end is the part that
+    // has to be protected, not the high end.
+    // Starts at 34, not 40: a bottle of green glass in indoor light renders at
+    // 48-55 degrees, and a gate that only reaches full strength at 56 gave those
+    // pixels less than half the correction. Skin sits at 30-38, so this is the
+    // steepest ramp that still leaves a face alone.
+    const float wg = smoothstep(34.0, 46.0, h) * (1.0 - smoothstep(152.0, 172.0, h));
+    const float corr = mix(cl, ch, ss) * wg;
+
+    const float hh = mod(h + corr, 360.0) / 60.0;
+    const float c = v * s;
+    const float xx = c * (1.0 - abs(mod(hh, 2.0) - 1.0));
+    const float m = v - c;
+    vec3 o_rgb;
+    if (hh < 1.0)      o_rgb = vec3(c, xx, 0.0);
+    else if (hh < 2.0) o_rgb = vec3(xx, c, 0.0);
+    else if (hh < 3.0) o_rgb = vec3(0.0, c, xx);
+    else if (hh < 4.0) o_rgb = vec3(0.0, xx, c);
+    else if (hh < 5.0) o_rgb = vec3(xx, 0.0, c);
+    else               o_rgb = vec3(c, 0.0, xx);
+    o_rgb += m;
+
+    const float luma0 = dot(rgb, vec3(0.2126, 0.7152, 0.0722));
+    const float luma1 = dot(o_rgb, vec3(0.2126, 0.7152, 0.0722));
+    if (luma1 > 1e-6) o_rgb *= luma0 / luma1;
+
+    output_data.value[o] = o_rgb.r;
+    output_data.value[o + 1u] = o_rgb.g;
+    output_data.value[o + 2u] = o_rgb.b;
+}
