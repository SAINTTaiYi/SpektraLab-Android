+// --- Progress::publish_stage / read_stage --------------------------------
+//
+// A seqlock, and the reason it is one: `stage` is the only thing that says
+// which node a render is inside, and the only thread allowed to touch it is the
+// render thread. A watchdog asking "where is it stuck" therefore cannot read
+// that string -- but it can read these two buffers, because every word is
+// atomic and the sequence tells it whether the write was in flight.
+//
+// The writer never blocks a reader and the reader never blocks the writer; the
+// worst case is one retry while a label is being copied, and labels are written
+// once per node.
+void Progress::publish_stage(const char* s) {
+    char buf[96];
+    std::snprintf(buf, sizeof buf, "%s", s ? s : "");
+    const uint32_t n = stage_seq.load(std::memory_order_relaxed);
+    std::atomic<uint32_t>& dst = stage_words[n & 1u][0];
+    for (size_t i = 0; i < 24; ++i) {
+        uint32_t w = 0;
+        std::memcpy(&w, buf + i * 4u, sizeof w);
+        (&dst)[i].store(w, std::memory_order_relaxed);
+    }
+    stage_seq.store(n + 1u, std::memory_order_release);
+}
+
+bool Progress::read_stage(char* out, size_t cap) const {
+    if (!out || cap == 0) return false;
+    char buf[96];
+    for (int attempt = 0; attempt < 3; ++attempt) {
+        const uint32_t before = stage_seq.load(std::memory_order_acquire);
+        const std::atomic<uint32_t>& src = stage_words[before & 1u][0];
+        for (size_t i = 0; i < 24; ++i) {
+            const uint32_t w = (&src)[i].load(std::memory_order_relaxed);
+            std::memcpy(buf + i * 4u, &w, sizeof w);
+        }
+        const uint32_t after = stage_seq.load(std::memory_order_acquire);
+        if (before != after) continue;          // the writer moved while we read
+        buf[sizeof buf - 1] = '\0';
+        std::snprintf(out, cap, "%s", buf);
+        return true;
+    }
+    return false;
+}
