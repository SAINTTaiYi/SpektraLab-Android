+Blur::Demand Pipeline::print_glare_demand() const {
+    // **A FIR blur is a halo, not a carried state.** The veil's field is a
+    // lognormal plane seeded per pixel plus a gaussian of `blur * tier_ratio *
+    // sqrt(amount)` pixels -- the reference's 0.5 px at the default, i.e. a
+    // two-row support. It was classed `Whole` when the class meant "the node
+    // allocates a plane", which is a memory property, not a context one: at a
+    // 77 MP canvas the whole-frame form is what the print side peaked on.
+    // Every guard here is `node_glare`'s own, so the two cannot disagree.
+    if (params_.io.scan_film || di_active_) return Blur::Demand{};
+    const GlareParams& glare = params_.print_render.glare;
+    const double percent = glare.percent * glare.amount;
+    if (!glare.active || percent <= 0.0) return Blur::Demand{};
+    if (!(glare.blur > 0.0)) return Blur::Demand{};
+    const double ratio = tier_ratio();
+    const double radius = std::sqrt(std::max(glare.amount, 0.0));
+    double sigma[3];
+    fill3(sigma, glare.blur * ratio * radius);
+    return Blur::demand(sigma);
+}
