diff --git a/engine/src/pipeline/tiling.hpp b/engine/src/pipeline/tiling.hpp
new file mode 100644
index 0000000..882979d
--- /dev/null
+++ b/engine/src/pipeline/tiling.hpp
@@ -0,0 +1,185 @@
+#pragma once
+
+// Row-band dispatch for row-independent kernels (docs/tiling.md).
+//
+// A stage passes straight through unless its widest windowed plane is larger
+// than the device can bind at once, so nothing changes on hardware that fits
+// the frame. SPK_FORCE_BAND_ROWS (and SPK_FORCE_BAND_ONLY=<kernel>) force bands
+// anyway, which is how a device that never needs them still proves the windows
+// are exact.
+
+#include "gpu/gpu.hpp"
+#include "image.hpp"
+
+#include <algorithm>
+#include <cstdlib>
+#include <cstdio>
+#include <cstring>
+#include <string>
+#include <vector>
+
+namespace spk {
+
+inline uint32_t plan_rows_hint(const Image& shape) { return shape.h; }
+
+// How many elements one band may cover. 2^21 is four octaves below the
+// addressing wall above; SPK_BAND_CAP exists only so the boundary can be swept
+// without a rebuild.
+inline uint64_t band_element_cap() {
+    static const uint64_t cap = [] {
+        if (const char* v = std::getenv("SPK_BAND_CAP")) {
+            const long long n = std::strtoll(v, nullptr, 10);
+            if (n > 0) return uint64_t(n);
+        }
+        return uint64_t(1ull << 21);
+    }();
+    return cap;
+}
+
+
+// **A cross-grid argument: the kernel reads the whole plane.** Its stride is 0
+// -- there is no per-row arithmetic -- so `dispatch_tiled` leaves it bound as
+// the caller gave it, and `Arg::buf` means "the whole buffer". The pool hands a
+// small plane a buffer a larger one used, so that is routinely not the plane:
+// a 1600x1066 preview can sit in the 190 MiB allocation of the 5000x3333 frame
+// it came from. Naming the plane's own bytes costs nothing where the limit is
+// generous and is the difference between rendering and a hard error where it is
+// not.
+inline gpu::Arg plane(const Image& img) {
+    return gpu::Arg::window(img.buf, 0, img.bytes());
+}
+
+// `strides[i]` is bytes per element for argument i; 0 means a side buffer that
+// stays bound whole. Two dispatch shapes exist and their strides differ:
+// one thread per pixel moves c*4 bytes per element (12 on an RGB plane), one
+// thread per element moves 4. Declaring the pixel stride for the element form
+// triples every window and the last band runs off the end of its buffer.
+inline bool dispatch_tiled(gpu::Gpu* gpu, const char* kernel,
+                           const std::vector<gpu::Arg>& args,
+                           const std::vector<uint32_t>& strides,
+                           const Image& shape, size_t elements, std::string& error,
+                           const std::vector<uint32_t>& halo = {},
+                           uint32_t origin_rows = 0) {
+    if (!gpu) { error = "dispatch_tiled: no device"; return false; }
+
+    std::vector<uint32_t> plan_strides(args.size(), 0u);
+    uint32_t widest = 0;
+    for (size_t i = 0; i < strides.size() && i < args.size(); ++i) {
+        plan_strides[i] = strides[i];
+        if (strides[i]) widest = std::max(widest, strides[i]);
+    }
+    uint32_t columns = 0;
+    if (shape.w && shape.h) {
+        if (elements == shape.pixels()) columns = shape.w;
+        else if (elements == shape.elements()) columns = shape.w * shape.c;
+    }
+
+    // **A binding names the plane, never the pool's allocation.** The pool
+    // hands a small plane a buffer a previous, larger one used, so `Arg::buf`'s
+    // "the whole buffer" is routinely bigger than the image -- a 1600x1066
+    // preview backed by the 190 MiB plane of the 5000x3333 frame it was
+    // downscaled from. That does not matter on a device that can bind 2 GiB and
+    // is the *first* thing that fails on one that can bind 128 MiB, in a
+    // dispatch that never needed banding at all. So every per-element argument
+    // is given the window its stride and the element count imply, banded or
+    // not. (The banded path below already did this; this is the same rule for
+    // the one-dispatch path.)
+    auto plane_windowed = [&]() {
+        std::vector<gpu::Arg> out = args;
+        for (size_t i = 0; i < out.size() && i < plan_strides.size(); ++i) {
+            if (!plan_strides[i] || !out[i].buffer || out[i].range) continue;
+            out[i].offset = 0;
+            out[i].range = uint64_t(elements) * plan_strides[i];
+        }
+        return out;
+    };
+
+    if (!widest || !columns) return gpu->dispatch(kernel, plane_windowed(), elements, error);
+
+    // A band of a larger frame: the buffer is band-sized, so the kernels that
+    // seed noise or geometry from the index must be told where in the frame
+    // this band sits. Origin is in elements, and a row is `columns` of them.
+    if (origin_rows && !(uint64_t(elements) > (1ull << 24))) {
+        if (const char* only = std::getenv("SPK_FORCE_BAND_ONLY")) {
+            if (*only && std::strcmp(only, kernel) != 0)
+                return gpu->dispatch_at(kernel, plane_windowed(), elements, 0, error);
+        }
+        return gpu->dispatch_at(kernel, plane_windowed(), elements, origin_rows * columns, error);
+    }
+
+    static const uint32_t forced = [] {
+        const char* v = std::getenv("SPK_FORCE_BAND_ROWS");
+        return v ? uint32_t(std::atoi(v)) : 0u;
+    }();
+    if (forced) {
+        const char* only = std::getenv("SPK_FORCE_BAND_ONLY");
+        if (only && *only && std::strcmp(only, kernel) != 0)
+            return gpu->dispatch(kernel, plane_windowed(), elements, error);
+    }
+
+    // **16,777,216 elements is a wall, not a budget.** A single dispatch past it
+    // -- even split into chunks by the caller -- comes back with the tail's
+    // values written over the head: the driver's addressing stops being exact
+    // there. Measured on this device with spk_matmul3 and spk_take_rgb, both
+    // agreeing to the element, and banded dispatches correct at every size.
+    // Below the wall a whole dispatch is fine; above it, only bands are.
+    constexpr uint64_t kDispatchElementWall = 1ull << 24;
+    // **A band may not live *at* the wall either.** The band size was
+    // `wall_rows = wall / columns`, so a 25.3 MP rebate canvas -- 4829 x 5229,
+    // the shape a portrait 135 export makes -- came out as one 3474-row band of
+    // 16,776,546 elements, six hundred short of the boundary the comment above
+    // says the driver stops being exact at. A field report (1.2.6, portrait
+    // full-size export only) showed the frame's head drawn again at its foot,
+    // which is what a band that did not land leaves behind: the pool's previous
+    // content, from the same picture. Casting to `uint32_t` is exact for a
+    // whole dispatch; this cap is the one number that keeps a *band* away from
+    // the boundary, and it changes nothing else -- a band is a contiguous
+    // element range, so the sum of the bands is bit-identical (measured: hash
+    // aa3eb5028b37e4a2 before and after at 4829 x 5229).
+    const uint64_t kBandElementCap = band_element_cap();
+    const uint64_t plane_bytes = uint64_t(elements) * widest;
+    const uint64_t limit = gpu->max_storage_buffer_range();
+    // **Whether to band at all is the device's question, not a constant.**
+    // The wall this cap exists to stay under is `maxComputeWorkGroupCount[0]`
+    // workgroups of 256 threads: 65,535 x 256 = 16,776,960 on the device it was
+    // measured on, which is where a single dispatch comes back holding the
+    // tail's values. A device that reports far more than that -- a Mali-G925
+    // reports 4,294,967,295, sixty-five thousand times the minimum -- issues
+    // the whole plane in one dispatch and is exact. On exactly those devices
+    // banding is not insurance, it is the defect: one line per band boundary,
+    // equally spaced, which a user reads as a ruler down the left edge. Field
+    // report (Mali-G925, 1.6.1r): turning the cap off removed all of it.
+    const uint64_t workgroups = gpu->max_compute_workgroups();
+    const uint64_t device_wall = workgroups ? workgroups * 256ull : (1ull << 24);
+    const bool over_cap = uint64_t(elements) > device_wall;
+    if (!forced && !over_cap && plane_bytes <= limit)
+        return gpu->dispatch(kernel, plane_windowed(), elements, error);
+
+    uint32_t rows = shape.h;
+    if (forced) {
+        rows = std::min(forced, shape.h);
+    } else {
+        const uint64_t per_row = std::max<uint64_t>(1, uint64_t(columns) * widest);
+        rows = uint32_t(std::max<uint64_t>(1, (limit * 3 / 4) / per_row));
+        // A band is a dispatch too, and it stays well this side of the wall.
+        (void)kDispatchElementWall;
+        const uint64_t cap_rows = std::max<uint64_t>(1, kBandElementCap / columns);
+        if (uint64_t(rows) > cap_rows) rows = uint32_t(cap_rows);
+    }
+    if (rows >= shape.h) return gpu->dispatch(kernel, plane_windowed(), elements, error);
+
+    if (const char* dbg = std::getenv("SPK_TILE_DEBUG")) {
+        if (*dbg == '1')
+            std::fprintf(stderr, "[tile] %s rows=%u band=%u columns=%u elements=%zu\n",
+                         kernel, plan_rows_hint(shape), rows, columns, elements);
+    }
+    gpu::TilePlan plan;
+    plan.rows = shape.h;
+    plan.columns = columns;
+    plan.band_rows = rows;
+    plan.stride = plan_strides;
+    plan.halo = halo;
+    return gpu->dispatch_banded(kernel, args, elements, plan, error);
+}
+
+}  // namespace spk
