+struct RawDecodeCache::Impl {
+    std::unique_ptr<CompatibleLibRaw> raw;
+    std::string path;
+    std::filesystem::file_time_type mtime{};
+    size_t max_pixels = 0;
+    /// The sensor's own visible pixels, read before unpack. `max_pixels` only
+    /// changes the *result* when it is small enough to trigger `half_size`
+    /// (`sensor_pixels > 2 * max_pixels`), so any cap at or above half the
+    /// sensor means the same thing as no cap at all -- and caching on the raw
+    /// number made the app's import cap (42 MP) and its export request (0)
+    /// look like different decodes of the same file, which they are not.
+    size_t pixels = 0;
+    bool valid = false;
+    /// **The demosaiced frame itself.** Reusing the *LibRaw object* (what this
+    /// cache used to keep) only skips `open_file` + `unpack`: the reuse path
+    /// still runs `dcraw_process`, and measured in one process on a 20.9 MP
+    /// NEF, a "hit" cost 1658 ms against 1637 ms for the miss. The pixels were
+    /// already decoded; holding them is what makes a hit a hit.
+    ///
+    /// A float frame is 12 B/px against LibRaw's 8, so it is held only up to
+    /// `kHeldMaxPixels`; past that the cache holds nothing rather than a
+    /// half-gigabyte nobody can afford.
+    DecodedRaw held;
+    std::array<float, 4> mul{};
+    bool has_mul = false;
+};
+
+RawDecodeCache::RawDecodeCache() : impl_(std::make_unique<Impl>()) {}
+RawDecodeCache::~RawDecodeCache() = default;
+
+void RawDecodeCache::clear() {
+    if (!impl_) return;
+    impl_->raw.reset();
+    impl_->valid = false;
+    impl_->path.clear();
+    impl_->pixels = 0;
+    impl_->held = DecodedRaw{};
+    impl_->has_mul = false;
+}
+
+bool RawDecodeCache::decode(const std::filesystem::path& source,
+                            const std::array<float, 4>* user_mul,
+                            DecodedRaw& out, std::string& error, size_t max_pixels) {
+    if (!impl_) impl_ = std::make_unique<Impl>();
+    std::error_code ec;
+    const auto mtime = std::filesystem::last_write_time(source, ec);
+    // **A cap that cannot reach `half_size` is the same cap as no cap.** See
+    // `Impl::pixels`. Without this, importing a RAW (cap = the app's pixel
+    // budget) and then exporting it (cap = 0, the file's own size) decoded the
+    // very same file twice -- about 1.1 s of the export, and the two results
+    // were identical anyway.
+    const auto effective_cap = [](size_t cap, size_t px) -> size_t {
+        if (cap == 0) return 0;
+        if (px != 0 && cap >= (px + 1) / 2) return 0;   // 2 * cap >= px
+        return cap;
+    };
+    const bool same_cap =
+        impl_->max_pixels == max_pixels ||
+        effective_cap(impl_->max_pixels, impl_->pixels)
+            == effective_cap(max_pixels, impl_->pixels);
+    // **The white balance is part of the pixels**, not of the file: a frame
+    // whose Kelvin moved has to be decoded again.
+    const bool same_mul = impl_->has_mul == (user_mul != nullptr) &&
+                          (!user_mul || impl_->mul == *user_mul);
+    const bool reusable = impl_->valid && !impl_->held.rgb.empty() && !ec &&
+                          impl_->path == source.string() &&
+                          impl_->mtime == mtime &&
+                          same_cap && same_mul;
+    if (reusable) {
+        out = impl_->held;      // one copy, no demosaic
+        return true;
+    }
+    clear();
+    impl_->raw = std::make_unique<CompatibleLibRaw>();
+    // `borrow` is non-null but `reuse` is false: the object is one we keep, and
+    // this first call still has to open and unpack into it.
+    if (!decode_raw_compatible_impl(source, user_mul, out, error, max_pixels,
+                                    impl_->raw.get(), false)) {
+        impl_->raw.reset();
+        return false;
+    }
+    impl_->path = source.string();
+    impl_->mtime = mtime;
+    impl_->max_pixels = max_pixels;
+    if (impl_->raw) {
+        const auto& dims = impl_->raw->imgdata.sizes;
+        impl_->pixels = size_t(dims.width) * size_t(dims.height);
+    }
+    // **LibRaw's buffers go first.** They are the same order as the float
+    // frame, and only one of the two is needed from here on.
+    impl_->raw.reset();
+    if (out.rgb.size() <= kHeldMaxPixels * 3) {
+        impl_->held = out;
+        impl_->mul = user_mul ? *user_mul : std::array<float, 4>{};
+        impl_->has_mul = user_mul != nullptr;
+    }
+    impl_->valid = !ec;
+    return true;
+}
